DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/taskmanager"
JWT_SECRET="replace_with_a_long_random_string"

# Email (production only). In development, emails go to a temporary
# Ethereal test inbox automatically and need no settings: the terminal
# prints a preview link for each email.
RESEND_API_KEY="your_resend_api_key"
MAIL_FROM="Task Manager <noreply@yourdomain.com>"